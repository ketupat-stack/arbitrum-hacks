# ─────────────────────────────────────────────────────────────────────────────
# PathtrickSBT — Environment Variables
# Copy this file to .env and fill in the values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Private key of the DEPLOYER wallet used to broadcast deployment.
# Format: raw hex, no 0x prefix (Foundry reads it as uint256).
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Owner address for administration. Prefer a multisig address.
OWNER_ADDRESS=0x0000000000000000000000000000000000000001

# Arbitrum Sepolia RPC endpoint (chain ID 421614).
# Get one from https://chainlist.org/chain/421614 or https://www.alchemy.com/
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Arbitrum One RPC endpoint (chain ID 42161).
# Get one from https://chainlist.org/chain/42161 or https://www.alchemy.com/
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Arbiscan API key for contract verification on Arbitrum.
# Register at https://arbiscan.io/register
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY_HERE

# Public address of the Backend AI wallet.
# This address acts as the Admin Signer. The Backend uses its private key
# to generate EIP-712 signatures. The contract verifies signatures against this address.
ADMIN_SIGNER=0x6C240DB75811f513515A366057e43de7b313E6eD

# (Optional) Paxos USDG stablecoin address. Use address(0) to disable USDG payments.
# Arbitrum One mainnet address: TBD (check https://paxos.com/usdg)
USDG_TOKEN=0x0000000000000000000000000000000000000000

# IPFS metadata URI for SBT certificates. REQUIRED for deployment.
# ⚠️  NEVER deploy to Mainnet with a placeholder. Upload your metadata to IPFS first.
# Format: ipfs://<CID>/{id}.json  (ERC-1155 standard uses {id} as the token ID placeholder)
# Example: ipfs://QmYourRealCIDHere/{id}.json
TOKEN_URI=ipfs://QmYourRealCIDHere/{id}.json
